<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-200">
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost text-xl">KeenAuth Permissions Test</a>
    </div>
    <div class="flex-none gap-2">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost">
          <span class="hidden sm:inline"><%= @user.display_name || @user.email %></span>
          <div class="avatar placeholder">
            <div class="bg-primary text-primary-content w-8 rounded-full">
              <span class="text-sm"><%= String.first(@user.display_name || @user.email || "?") %></span>
            </div>
          </div>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-52 p-2 shadow">
          <li><a href="/dashboard">Dashboard</a></li>
          <li><a href="/users">Users</a></li>
          <li><a href="/groups">Groups</a></li>
          <li><a href="/permissions">Permissions</a></li>
          <li><a href="/perm-sets">Permission Sets</a></li>
          <li><a href="/tenants">Tenants</a></li>
          <li><a href="/events">Events</a></li>
          <li class="divider"></li>
          <li><a href="/auth/delete" class="text-error">Logout</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Dashboard</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <a href="/users" class="card bg-primary text-primary-content hover:bg-primary-focus transition">
        <div class="card-body">
          <h2 class="card-title">Users</h2>
          <p>Manage system users</p>
        </div>
      </a>

      <a href="/groups" class="card bg-secondary text-secondary-content hover:bg-secondary-focus transition">
        <div class="card-body">
          <h2 class="card-title">Groups</h2>
          <p>Manage user groups</p>
        </div>
      </a>

      <a href="/permissions" class="card bg-accent text-accent-content hover:bg-accent-focus transition">
        <div class="card-body">
          <h2 class="card-title">Permissions</h2>
          <p>View permissions</p>
        </div>
      </a>

      <a href="/perm-sets" class="card bg-neutral text-neutral-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">Permission Sets</h2>
          <p>Manage permission sets</p>
        </div>
      </a>

      <a href="/tenants" class="card bg-success text-success-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">Tenants</h2>
          <p>Manage tenants</p>
        </div>
      </a>

      <a href="/events" class="card bg-warning text-warning-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">Events</h2>
          <p>View user events</p>
        </div>
      </a>

      <a href="/demo" class="card bg-info text-info-content hover:bg-info-focus transition">
        <div class="card-body">
          <h2 class="card-title">Demo</h2>
          <p>Permission helpers demo</p>
        </div>
      </a>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Your Profile</h2>

        <div class="overflow-x-auto">
          <table class="table">
            <tbody>
              <tr>
                <th>User ID</th>
                <td><%= @user.id %></td>
              </tr>
              <tr>
                <th>Username</th>
                <td><%= @user.username %></td>
              </tr>
              <tr>
                <th>Email</th>
                <td><%= @user.email %></td>
              </tr>
              <tr>
                <th>Display Name</th>
                <td><%= @user.display_name %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="divider"></div>

        <h3 class="text-lg font-semibold">Groups (<%= length(@user.roles || []) %>)</h3>
        <div class="flex flex-wrap gap-2">
          <%= for group <- @user.roles || [] do %>
            <span class="badge badge-primary badge-lg"><%= group %></span>
          <% end %>
          <%= if Enum.empty?(@user.roles || []) do %>
            <span class="text-base-content/50">No groups assigned</span>
          <% end %>
        </div>

        <div class="divider"></div>

        <h3 class="text-lg font-semibold">Permissions (<%= length(@user.permissions || []) %>)</h3>
        <div class="flex flex-wrap gap-2">
          <%= for perm <- @user.permissions || [] do %>
            <span class="badge badge-secondary"><%= perm %></span>
          <% end %>
          <%= if Enum.empty?(@user.permissions || []) do %>
            <span class="text-base-content/50">No permissions assigned</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
