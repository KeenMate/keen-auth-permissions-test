<Layouts.flash_group flash={@flash} />
<.admin_layout current_page={:dashboard}>
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Dashboard</h1>
      <div class="breadcrumbs text-sm">
        <ul>
          <li><a href="/">Home</a></li>
          <li>Dashboard</li>
        </ul>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <a
        href="/users"
        class="card bg-primary text-primary-content hover:bg-primary-focus transition"
      >
        <div class="card-body">
          <h2 class="card-title">Users</h2>
          <p>Manage system users</p>
        </div>
      </a>
      <a
        href="/groups"
        class="card bg-secondary text-secondary-content hover:bg-secondary-focus transition"
      >
        <div class="card-body">
          <h2 class="card-title">Groups</h2>
          <p>Manage user groups</p>
        </div>
      </a>
      <a
        href="/permissions"
        class="card bg-accent text-accent-content hover:bg-accent-focus transition"
      >
        <div class="card-body">
          <h2 class="card-title">Permissions</h2>
          <p>View permissions</p>
        </div>
      </a>
      <a
        href="/perm-sets"
        class="card bg-neutral text-neutral-content hover:opacity-90 transition"
      >
        <div class="card-body">
          <h2 class="card-title">Permission Sets</h2>
          <p>Manage permission sets</p>
        </div>
      </a>
      <a href="/tenants" class="card bg-success text-success-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">Tenants</h2>
          <p>Manage tenants</p>
        </div>
      </a>
      <a href="/events" class="card bg-warning text-warning-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">Events</h2>
          <p>View user events</p>
        </div>
      </a>
      <a href="/demo" class="card bg-info text-info-content hover:bg-info-focus transition">
        <div class="card-body">
          <h2 class="card-title">Demo</h2>
          <p>Permission helpers demo</p>
        </div>
      </a>
      <a
        href="/resource-types"
        class="card bg-primary text-primary-content hover:opacity-90 transition"
      >
        <div class="card-body">
          <h2 class="card-title">Resource Types</h2>
          <p>Manage resource types</p>
        </div>
      </a>
      <a
        href="/resource-access"
        class="card bg-secondary text-secondary-content hover:opacity-90 transition"
      >
        <div class="card-body">
          <h2 class="card-title">Resource Access</h2>
          <p>Resource-level ACL</p>
        </div>
      </a>
      <a href="/blacklist" class="card bg-error text-error-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">Blacklist</h2>
          <p>Manage blacklisted users</p>
        </div>
      </a>
      <a href="/mfa" class="card bg-warning text-warning-content hover:opacity-90 transition">
        <div class="card-body">
          <h2 class="card-title">MFA</h2>
          <p>Multi-factor authentication</p>
        </div>
      </a>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Your Profile</h2>

        <div class="overflow-x-auto">
          <table class="table">
            <tbody>
              <tr>
                <th>User ID</th>
                <td>{@user.user_id}</td>
              </tr>
              <tr>
                <th>Username</th>
                <td>{@user.username}</td>
              </tr>
              <tr>
                <th>Email</th>
                <td>{@user.email}</td>
              </tr>
              <tr>
                <th>Display Name</th>
                <td>{@user.display_name}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="divider"></div>

        <h3 class="text-lg font-semibold">Groups ({length(@user.groups || [])})</h3>

        <div class="flex flex-wrap gap-2">
          <%= for group <- @user.groups || [] do %>
            <span class="badge badge-primary badge-lg">{group}</span>
          <% end %>

          <%= if Enum.empty?(@user.groups || []) do %>
            <span class="text-base-content/50">No groups assigned</span>
          <% end %>
        </div>

        <div class="divider"></div>

        <h3 class="text-lg font-semibold">Permissions ({length(@full_permissions)})</h3>

        <div class="flex flex-wrap gap-2">
          <%= for perm <- @full_permissions do %>
            <span class="badge badge-secondary">{perm}</span>
          <% end %>

          <%= if Enum.empty?(@full_permissions) do %>
            <span class="text-base-content/50">No permissions assigned</span>
          <% end %>
        </div>
      </div>
    </div>
</.admin_layout>
