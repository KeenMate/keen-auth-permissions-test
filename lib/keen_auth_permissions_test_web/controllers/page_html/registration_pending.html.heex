<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-200 flex items-center justify-center">
  <div class="card bg-base-100 w-full max-w-lg shadow-2xl">
    <div class="card-body">
      <h1 class="card-title text-2xl justify-center mb-2">Account Created</h1>

      <p class="text-center text-base-content/70 mb-4">
        A confirmation email has been sent to <strong><%= @email %></strong>.
      </p>

      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <p class="font-semibold">Dev/Test Mode</p>
          <p class="text-sm">In production this token would be emailed. Click the link below to confirm your account.</p>
        </div>
      </div>

      <div class="mt-4">
        <a href={"/confirm?token=#{@token}"} class="btn btn-primary w-full">
          Confirm Email Address
        </a>
      </div>

      <div class="mt-2 collapse collapse-arrow bg-base-200">
        <input type="checkbox" />
        <div class="collapse-title text-sm font-medium">Show raw token</div>
        <div class="collapse-content">
          <code class="text-xs break-all"><%= @token %></code>
        </div>
      </div>

      <div class="divider"></div>

      <a href="/login" class="btn btn-ghost">Back to Sign In</a>
    </div>
  </div>
</div>
